{
  "name": "Trends+Manual -> News -> Supabase -> Claude -> WordPress (with Telegram approval x3)",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 3 }
          ]
        }
      }
    },
    {
      "id": "fetch-trends-rss",
      "name": "Fetch Trends RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "GET",
        "url": "https://trends.google.com/trending/rss?geo=KR&hl=ko&hours=48",
        "options": {
          "response": { "response": { "responseFormat": "text" } }
        }
      }
    },
    {
      "id": "xml-to-json",
      "name": "XML to JSON",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [520, 0],
      "parameters": {
        "dataPropertyName": "data"
      }
    },
    {
      "id": "extract-top20",
      "name": "Extract Top 20",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0],
      "parameters": {
        "jsCode": "const root = $input.first().json.rss.channel;\nconst channel = Array.isArray(root) ? root[0] : root;\nconst rawItems = channel.item;\nconst items = Array.isArray(rawItems) ? rawItems : [rawItems];\nconst trendDate = new Date().toISOString().slice(0, 10);\n\nconst pick = (obj, key) => {\n  const v = obj?.[key];\n  return Array.isArray(v) ? v[0] : v;\n};\n\nconst results = items.slice(0, 20).map((item, idx) => ({\n  json: {\n    rank: idx + 1,\n    keyword: pick(item, 'title') || '',\n    approx_traffic: pick(item, 'ht:approx_traffic') || null,\n    trend_link: pick(item, 'link') || '',\n    region: 'KR',\n    trend_date: trendDate,\n    source: 'trend'\n  }\n}));\n\nreturn results;\n\n// NOTE: field names above (e.g. 'ht:approx_traffic') depend on how the\n// XML node namespaces tags in your n8n version. Verify against a live run."
      }
    },
    {
      "id": "insert-keywords-history",
      "name": "Insert Keywords History",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1040, 0],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "trending_keywords",
        "dataToSend": "autoMapInputData"
      },
      "credentials": {
        "supabaseApi": { "id": "REPLACE_WITH_YOUR_SUPABASE_CREDENTIAL_ID", "name": "Supabase account" }
      },
      "notes": "Runs BEFORE Get Recently Posted (sequential, not parallel) so that this run's rows are guaranteed to exist -- with their DB id -- by the time Pick Next Keyword looks them up."
    },
    {
      "id": "get-recently-posted",
      "name": "Get Recently Posted",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1300, 0],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "trending_keywords",
        "returnAll": true
      },
      "credentials": {
        "supabaseApi": { "id": "REPLACE_WITH_YOUR_SUPABASE_CREDENTIAL_ID", "name": "Supabase account" }
      },
      "notes": "Fetches ALL rows -- both the cooldown filtering and today's row-id lookup happen in the next Code node, to avoid depending on Supabase filter-param schema (which varies by n8n version)."
    },
    {
      "id": "pick-next-keyword",
      "name": "Pick Next Keyword",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 0],
      "parameters": {
        "jsCode": "const COOLDOWN_DAYS = 14;\nconst cooldownMs = COOLDOWN_DAYS * 24 * 60 * 60 * 1000;\nconst now = Date.now();\nconst today = new Date().toISOString().slice(0, 10);\n\nconst topKeywords = $('Extract Top 20').all().map(i => i.json); // ranked, index 0 = highest volume\nconst allRows = $input.all().map(i => i.json); // Get Recently Posted output (includes rows Insert Keywords History just wrote)\n\nconst recentlyPosted = new Set(\n  allRows\n    .filter(r => r.posted_at && (now - new Date(r.posted_at).getTime()) < cooldownMs)\n    .map(r => r.keyword)\n);\n\nconst candidate = topKeywords.find(k => !recentlyPosted.has(k.keyword));\nif (!candidate) {\n  return []; // nothing new this run -- everything downstream simply won't fire\n}\n\nconst dbRow = allRows.find(r => r.keyword === candidate.keyword && r.trend_date === today && r.region === 'KR');\nif (!dbRow) {\n  // Should not happen since Insert Keywords History ran first, but bail safely if it does.\n  return [];\n}\n\nreturn [{\n  json: {\n    id: dbRow.id,\n    keyword: dbRow.keyword,\n    approx_traffic: dbRow.approx_traffic,\n    trend_link: dbRow.trend_link\n  }\n}];"
      }
    },
    {
      "id": "telegram-keyword-approval",
      "name": "Send Telegram Keyword Approval",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1820, 0],
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "=오늘의 트렌드 키워드 후보: *{{ $json.keyword }}*\n(검색량: {{ $json.approx_traffic || '정보없음' }})\n\n이 키워드로 포스팅을 진행할까요?",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": "={{ { inline_keyboard: [ [ { text: '✅ 승인', url: $execution.resumeUrl + '&decision=approve' }, { text: '❌ 거절', url: $execution.resumeUrl + '&decision=reject' } ] ] } }}"
        }
      },
      "credentials": {
        "telegramApi": { "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot" }
      },
      "notes": "VERIFY IN UI: reply_markup field path may differ by n8n version. If buttons don't render, rebuild via the node's own Reply Markup -> Inline Keyboard UI, URL = {{ $execution.resumeUrl }}?decision=approve / reject."
    },
    {
      "id": "wait-keyword-approval",
      "name": "Wait Keyword Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2080, 0],
      "webhookId": "wait-keyword-approval-hook",
      "parameters": { "resume": "webhook", "options": {} }
    },
    {
      "id": "if-keyword-approved",
      "name": "IF Keyword Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2340, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.query.decision }}",
              "rightValue": "approve",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "notes": "VERIFY IN UI: confirm the resumed data actually lands at $json.query.decision for your n8n version."
    },
    {
      "id": "telegram-trigger-manual",
      "name": "Telegram Trigger (Manual Keyword)",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 700],
      "parameters": { "updates": ["message"] },
      "credentials": {
        "telegramApi": { "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot" }
      }
    },
    {
      "id": "parse-manual-keyword",
      "name": "Parse Manual Keyword",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 700],
      "parameters": {
        "jsCode": "const message = $input.first().json.message;\nconst text = (message && message.text) || '';\nconst match = text.match(/^\\/post\\s+(.+)/i);\nif (!match) {\n  return []; // not a /post command -- ignore\n}\nconst keyword = match[1].trim();\nconst today = new Date().toISOString().slice(0, 10);\nreturn [{\n  json: {\n    keyword,\n    rank: null,\n    approx_traffic: null,\n    trend_link: null,\n    region: 'KR',\n    trend_date: today,\n    source: 'manual'\n  }\n}];"
      }
    },
    {
      "id": "insert-manual-keyword",
      "name": "Insert Manual Keyword",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [520, 700],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "trending_keywords",
        "dataToSend": "autoMapInputData"
      },
      "credentials": {
        "supabaseApi": { "id": "REPLACE_WITH_YOUR_SUPABASE_CREDENTIAL_ID", "name": "Supabase account" }
      }
    },
    {
      "id": "keyword-context",
      "name": "Keyword Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2600, 300],
      "parameters": {
        "jsCode": "// Single convergence point for Flow A (approved trend, arrives after a Wait node -- so $json/$input\n// at this point would just be the Telegram resume payload, NOT the keyword data) and Flow B (manual\n// /post, arrives directly with no Wait in between). Reference the real source explicitly by name.\nlet source;\ntry {\n  source = $('Pick Next Keyword').item.json;\n} catch (e) {\n  source = $('Insert Manual Keyword').item.json;\n}\nreturn [{\n  json: {\n    id: source.id,\n    keyword: source.keyword,\n    trend_link: source.trend_link || null\n  }\n}];"
      }
    },
    {
      "id": "search-naver-news",
      "name": "Search Naver News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://naverapihub.apigw.ntruss.com/search/v1/news?query={{ encodeURIComponent($json.keyword) }}&display=10&sort=date",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-NCP-APIGW-API-KEY-ID", "value": "REPLACE_WITH_YOUR_CLIENT_ID" },
            { "name": "X-NCP-APIGW-API-KEY", "value": "REPLACE_WITH_YOUR_CLIENT_SECRET" }
          ]
        }
      },
      "notes": "sort=date so the most recent articles come first, required for the recency filter next."
    },
    {
      "id": "parse-split-articles",
      "name": "Parse & Split Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3120, 300],
      "parameters": {
        "jsCode": "const RECENCY_HOURS = 48;\nconst keywordCtx = $('Keyword Context').item.json;\nconst response = $input.first().json;\nconst articles = response.items || [];\nconst cutoff = Date.now() - RECENCY_HOURS * 3600 * 1000;\n\nconst recent = articles.filter(a => {\n  const t = new Date(a.pubDate).getTime();\n  return !isNaN(t) && t >= cutoff;\n});\n\nreturn recent.map(a => ({\n  json: {\n    keyword_id: keywordCtx.id,\n    title: (a.title || '').replace(/<[^>]+>/g, ''),\n    url: a.originallink || a.link,\n    source: 'naver_news',\n    published_at: a.pubDate\n  }\n}));"
      }
    },
    {
      "id": "insert-news",
      "name": "Insert News",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [3380, 300],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "keyword_news",
        "dataToSend": "autoMapInputData"
      },
      "credentials": {
        "supabaseApi": { "id": "REPLACE_WITH_YOUR_SUPABASE_CREDENTIAL_ID", "name": "Supabase account" }
      }
    },
    {
      "id": "aggregate-news",
      "name": "Aggregate News",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [3640, 300],
      "parameters": {
        "aggregate": "aggregateIndividualFields",
        "fieldsToAggregate": {
          "fieldToAggregate": [
            { "fieldToAggregate": "title", "renameField": false },
            { "fieldToAggregate": "url", "renameField": false }
          ]
        }
      }
    },
    {
      "id": "if-news-found",
      "name": "IF News Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3900, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ ($json.title || []).length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "telegram-no-news",
      "name": "Telegram: No Recent News",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [4160, 480],
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "=키워드 *{{ $('Keyword Context').item.json.keyword }}* 에 대해 최근 48시간 내 뉴스가 없어 이번 회차는 건너뜁니다.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "credentials": {
        "telegramApi": { "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot" }
      }
    },
    {
      "id": "build-news-summary",
      "name": "Build News Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4160, 150],
      "parameters": {
        "jsCode": "const keywordCtx = $('Keyword Context').item.json;\nconst agg = $input.first().json;\nconst titles = agg.title || [];\nconst urls = agg.url || [];\nconst newsLines = titles.map((t, i) => `${i + 1}. ${t}\\n   ${urls[i] || ''}`).join('\\n') || '(관련 뉴스 없음)';\n\nreturn [{\n  json: {\n    keyword: keywordCtx.keyword,\n    trend_link: keywordCtx.trend_link,\n    news_list: newsLines\n  }\n}];"
      }
    },
    {
      "id": "telegram-news-review",
      "name": "Send Telegram News Review",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [4420, 150],
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "=📰 *{{ $json.keyword }}* 관련 수집된 뉴스:\n\n{{ $json.news_list }}\n\n이 뉴스로 초안을 작성할까요?",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": "={{ { inline_keyboard: [ [ { text: '✅ 진행', url: $execution.resumeUrl + '&decision=approve' }, { text: '❌ 취소', url: $execution.resumeUrl + '&decision=reject' } ] ] } }}"
        }
      },
      "credentials": {
        "telegramApi": { "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot" }
      },
      "notes": "Same reply_markup caveat as the other Telegram approval nodes -- verify in UI."
    },
    {
      "id": "wait-news-review",
      "name": "Wait News Review",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [4680, 150],
      "webhookId": "wait-news-review-hook",
      "parameters": { "resume": "webhook", "options": {} }
    },
    {
      "id": "if-news-approved",
      "name": "IF News Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [4940, 150],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.query.decision }}",
              "rightValue": "approve",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "telegram-news-rejected",
      "name": "Telegram: News Review Rejected",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [5200, 300],
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "=키워드 *{{ $('Keyword Context').item.json.keyword }}* 초안 작성이 취소되었습니다.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "credentials": {
        "telegramApi": { "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot" }
      }
    },
    {
      "id": "claude-draft",
      "name": "Claude Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [5200, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-5\", max_tokens: 2000, tools: [{ name: \"blog_draft\", description: \"트렌드 키워드를 요약한 블로그 초안 생성\", input_schema: { type: \"object\", properties: { title: { type: \"string\" }, body_html: { type: \"string\" }, tags: { type: \"array\", items: { type: \"string\" } }, meta_description: { type: \"string\" } }, required: [\"title\", \"body_html\", \"tags\", \"meta_description\"] } }], tool_choice: { type: \"tool\", name: \"blog_draft\" }, messages: [{ role: \"user\", content: `지금 화제인 키워드: ${$('Build News Summary').item.json.keyword}\\n\\n관련 뉴스:\\n${$('Build News Summary').item.json.news_list}\\n\\nGoogle Trends 원본 링크: ${$('Build News Summary').item.json.trend_link}\\n\\n위 내용을 바탕으로 이 키워드가 왜 화제인지 분석하는 한국어 블로그 글을 작성해줘. body_html 끝에는 참고한 뉴스 출처 링크를 명시해줘.` }] }) }}"
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_YOUR_ANTHROPIC_CREDENTIAL_ID", "name": "Anthropic x-api-key" }
      },
      "notes": "References 'Build News Summary' by name (not $json) because $json here is the Wait node's resumed payload, not the news summary."
    },
    {
      "id": "parse-claude-response",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [5460, 0],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst toolUse = (response.content || []).find(c => c.type === 'tool_use');\nif (!toolUse) {\n  throw new Error('Claude 응답에 tool_use가 없습니다: ' + JSON.stringify(response));\n}\nreturn [{ json: toolUse.input }];"
      }
    },
    {
      "id": "publish-wordpress",
      "name": "Publish WordPress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [5720, 0],
      "parameters": {
        "method": "POST",
        "url": "https://deohaam.com/wp-json/wp/v2/posts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, content: $json.body_html, excerpt: $json.meta_description, status: \"draft\" }) }}"
      },
      "credentials": {
        "httpBasicAuth": { "id": "REPLACE_WITH_YOUR_WORDPRESS_CREDENTIAL_ID", "name": "WordPress Application Password" }
      }
    },
    {
      "id": "build-preview-link",
      "name": "Build Preview Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [5980, 0],
      "parameters": {
        "jsCode": "const post = $input.first().json;\nreturn [{\n  json: {\n    ...post,\n    previewUrl: `https://deohaam.com/?p=${post.id}&preview=true`\n  }\n}];"
      }
    },
    {
      "id": "telegram-final-approval",
      "name": "Send Telegram Final Approval",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [6240, 0],
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "=초안이 준비됐습니다.\n제목: {{ $json.title }}\n미리보기: {{ $json.previewUrl }}\n\n발행할까요?",
        "additionalFields": {
          "reply_markup": "={{ { inline_keyboard: [ [ { text: '✅ 발행', url: $execution.resumeUrl + '&decision=approve' }, { text: '❌ 삭제', url: $execution.resumeUrl + '&decision=reject' } ] ] } }}"
        }
      },
      "credentials": {
        "telegramApi": { "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID", "name": "Telegram Bot" }
      },
      "notes": "Same reply_markup caveat -- verify in UI."
    },
    {
      "id": "wait-final-approval",
      "name": "Wait Final Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [6500, 0],
      "webhookId": "wait-final-approval-hook",
      "parameters": { "resume": "webhook", "options": {} }
    },
    {
      "id": "if-final-approved",
      "name": "IF Final Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [6760, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.query.decision }}",
              "rightValue": "approve",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "publish-status-update",
      "name": "Publish Status Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [7020, -120],
      "parameters": {
        "method": "POST",
        "url": "=https://deohaam.com/wp-json/wp/v2/posts/{{ $('Build Preview Link').item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: \"publish\" }) }}"
